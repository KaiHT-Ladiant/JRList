{
  "manifest_version": 3,
  "name": "JRList",
  "version": "1.1.1",
  "description": "Nuxt.js / Vue.js 페이지에서 URL·라우트·API 경로를 추출하는 도구 (JS URL Recon List)",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JRList",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/page-bridge.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
